// SENTINEL - Two-Tier Execution Flowchart (Figure 1 - Large Font Size)
// Render: dot -Tpng -Gdpi=300 sentinel_flow.dot -o sentinel_flow.png

digraph sentinel_flow {
    rankdir=TB;
    bgcolor="white";
    nodesep=0.55;
    ranksep=0.6;

    node [shape=box, style="rounded,filled", fontname="DejaVu Serif Bold", fontsize=15, margin="0.25,0.18", penwidth=2.0];
    edge [fontname="DejaVu Serif Bold", fontsize=13, color="#1A252C", penwidth=1.8];

    // Inputs
    start    [label="Raw Network Telemetry Stream\n(NGFW, IDS/IPS, EDR -> Redis Stream)", shape=oval, fillcolor="#D6EAF8", color="#1B4F72", fontsize=16];

    // Tier 1 Group
    subgraph cluster_tier1 {
        label = "TIER 1: WIRE-SPEED FILTER & MACHINE LEARNING GATE";
        style = "dashed,rounded";
        color = "#1E8449";
        bgcolor = "#EAFAF1";
        fontname = "DejaVu Serif Bold";
        fontsize = 18;
        fontcolor = "#145A32";

        t1_filter [label="Online Welford O(1) Statistical Filter\n(Online Z-Score Anomaly Calculation)", fillcolor="#A9DFBF", color="#1E8449"];
        t1_cache  [label="Tier 1.75 Semantic Cache\n(RAM Payload Template Hash -> 1ms)", fillcolor="#A9DFBF", color="#1E8449"];
        t1_mlgate [label="LightGBM Machine Learning Gate\n(Sub-0.35ms Inference, Anti-Evasion ±8σ)", fillcolor="#A9DFBF", color="#1E8449"];
    }

    t1_check  [label="Anomalous Event or\nRequires Inspection?", shape=diamond, fillcolor="#FCF3CF", color="#B7950B", fontsize=15];
    t1_benign [label="Tier 1 Offload (> 80% Noise Shed)\n(Adjudication: LOG / Pass)", fillcolor="#D5D8DC", color="#4A235A", fontsize=15];

    // Escalation
    escalate  [label="ESCALATE ANOMALOUS TELEMETRY TO TIER 2", fillcolor="#AED6F1", color="#1B4F72", fontsize=16];

    // Tier 2 Group
    subgraph cluster_tier2 {
        label = "TIER 2: COGNITIVE REASONING AGENT (LANGGRAPH AGENT)";
        style = "dashed,rounded";
        color = "#B03A2E";
        bgcolor = "#FDEDEC";
        fontname = "DejaVu Serif Bold";
        fontsize = 18;
        fontcolor = "#641E16";

        t2_guard [label="Guardrails & Security Encapsulation\n(Delimited Cryptographic Nonce + Token Miner)", fillcolor="#FADBD8", color="#B03A2E"];
        t2_rag   [label="Dual-RAG (FAISS + BM25 RRF, k=60)\n+ Threat Memory (SQLite Reputation)", fillcolor="#FADBD8", color="#B03A2E"];
        t2_llm   [label="Foundation-Sec-8B-Instruct Reasoning Engine\n(Quantized GGUF Q4_K_M via llama.cpp CUDA)", fillcolor="#FADBD8", color="#B03A2E"];
        t2_valid [label="DecisionValidator & Deterministic Guardrails\n(Enforcing Pydantic LLMDecision Schema & Whitelist)", fillcolor="#FADBD8", color="#B03A2E"];
    }

    t2_action [label="Adjudication\nAction?", shape=diamond, fillcolor="#FCF3CF", color="#B7950B", fontsize=15];

    // Actions
    act_block [label="BLOCK_IP\n(Automated Execution of IP Block Rule)", fillcolor="#F9EBEA", color="#922B21", fontsize=16];
    act_hitl  [label="AWAIT_HITL\n(Escalated to Streamlit Human Queue)", fillcolor="#FDEBD0", color="#B9770E", fontsize=16];
    act_log   [label="LOG\n(Log Telemetry & Continuous Monitoring)", fillcolor="#E5E7E9", color="#5D6D7E", fontsize=16];

    // Audit
    hmac_audit [label="HMAC-SHA256 Cryptographic Audit Sealing\n(Tamper-Evident Non-Repudiation Log Chain)", fillcolor="#E8DAEF", color="#6C3483", fontsize=16];
    end_node   [label="Pipeline Execution Complete", shape=oval, fillcolor="#E5E7E9", color="#283747", fontsize=15];

    // Connections
    start -> t1_filter;
    t1_filter -> t1_cache -> t1_mlgate -> t1_check;
    t1_check -> t1_benign [label=" No (Benign) "];
    t1_check -> escalate  [label=" Yes (Anomalous) "];

    escalate -> t2_guard;
    t2_guard -> t2_rag -> t2_llm -> t2_valid -> t2_action;

    t2_action -> act_block [label=" BLOCK_IP "];
    t2_action -> act_hitl  [label=" AWAIT_HITL "];
    t2_action -> act_log   [label=" LOG "];

    act_block -> hmac_audit;
    act_hitl  -> hmac_audit;
    act_log   -> hmac_audit;
    t1_benign -> hmac_audit;

    hmac_audit -> end_node;
}
