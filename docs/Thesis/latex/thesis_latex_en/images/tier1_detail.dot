// SENTINEL — Tier 1 expanded (Section 3.3). Shows which branches TERMINATE and
// which single branch escalates, because that distinction defines "offload" in Chapter 4.
// Render: dot -Tpdf tier1_detail.dot -o tier1_detail.pdf
digraph tier1_detail {
    rankdir=TB;
    bgcolor="white";
    nodesep=0.40;
    ranksep=0.45;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12,
          margin="0.20,0.12", penwidth=1.6, color="#2e7d32", fillcolor="#e8f5e9"];
    edge [fontname="Helvetica", fontsize=10, color="#546e7a", penwidth=1.3];

    inp [label="Normalised event from the ingestion queue", shape=oval, fillcolor="#e3f2fd", color="#1565c0"];

    welford [label="Welford O(1) online statistics\nrolling Z-score against the per-key baseline"];
    sig     [label="Application signature set\n29 web attack families, OWASP CRS-style\nmulti-round decoding before matching"];
    cache   [label="Tier 1.75 semantic cache\nhash of the normalised query string"];
    mlgate  [label="LightGBM Machine Learning Gate\nZ-score clipping ±8σ · baseline imputation"];

    band [label="Four-band confidence policy\n0.85 / 0.65 / 0.40", shape=diamond, fillcolor="#fff8e1", color="#f9a825"];

    abstain [label="Distorted-feature share > 30%\n→ ABSTAIN", fillcolor="#fff3e0", color="#ef6c00"];

    term  [label="TERMINATES AT TIER 1\nBLOCK_IP (requires Tier 1 rule concurrence)\nALERT · AWAIT_HITL · DROP",
           fillcolor="#f5f5f5", color="#757575", penwidth=2.0];
    esc   [label="ESCALATE → Tier 2", fillcolor="#fdecea", color="#c62828", penwidth=2.0];

    inp -> welford -> sig -> cache -> mlgate -> band;
    mlgate -> abstain [style=dashed, label="  low confidence  "];
    abstain -> esc [style=dashed];
    band -> term [label="  resolved  "];
    band -> esc  [label="  needs reasoning  "];
}
