// SENTINEL — Cơ chế đóng gói Nonce và niêm phong chuỗi HMAC-SHA256 (Mục 3.6).
// Bố cục đơn cột dọc chuẩn 20pt phông chữ SIÊU TO LẤP ĐẦY TRANG A4.
// Render: dot -Tpdf nonce_hmac.dot -o nonce_hmac.pdf
digraph nonce_hmac {
    rankdir=TB;
    bgcolor="white";
    pad="0.05";
    nodesep=0.35;
    ranksep=0.32;
    node [shape=box, style="rounded,filled", fontname="DejaVu Serif", fontsize=20,
          width=5.2, margin="0.25,0.16", penwidth=2.4, color="#37474f", fillcolor="#eceff1"];
    edge [fontname="DejaVu Serif", fontsize=15, color="#37474f", penwidth=2.0];

    subgraph cluster_in {
        label="1. Biên đầu vào — Đóng gói Nonce chống tiêm nhiễm";
        fontname="DejaVu Serif"; fontsize=18; fontcolor="#2e7d32";
        style="dashed,rounded"; color="#2e7d32"; bgcolor="#f1f8e9";

        raw   [label="Nhật ký thô\n(URI / User-Agent / Syslog)", shape=oval, fillcolor="#fdecea", color="#c62828", width=4.8, fontsize=20, penwidth=2.4];
        wrap  [label="Đóng gói Nonce ngẫu nhiên động\n[nonce] ... dữ liệu thô ... [nonce]", fillcolor="#e8f5e9", color="#2e7d32", width=4.8, penwidth=2.4];
    }

    reason [label="2. Suy luận tác tử & Kiểm định rào chắn", fillcolor="#fff8e1", color="#f9a825", penwidth=2.5];

    subgraph cluster_out {
        label="3. Biên đầu ra — Niêm phong chuỗi HMAC-SHA256";
        fontname="DejaVu Serif"; fontsize=18; fontcolor="#5e35b1";
        style="dashed,rounded"; color="#5e35b1"; bgcolor="#f3e5f5";

        h1 [label="H₁ = HMAC(D₁ ‖ H₀, K)", fillcolor="#ede7f6", color="#5e35b1", width=2.4];
        h2 [label="H₂ = HMAC(D₂ ‖ H₁, K)", fillcolor="#ede7f6", color="#5e35b1", width=2.4];
        h1 -> h2 [label=" Nối xích ", color="#5e35b1"];
    }

    detect [label="Phát hiện ngay khi sửa / chèn / xóa bản ghi", fillcolor="#e8f5e9", color="#2e7d32", width=4.8, penwidth=2.5];

    raw -> wrap -> reason -> h1;
    h2 -> detect [color="#2e7d32", penwidth=2.0];
}
