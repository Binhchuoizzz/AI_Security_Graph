// SENTINEL — hai cơ chế mật mã (Mục 3.6): đóng gói nonce theo lô ở đầu vào,
// chuỗi HMAC ở đầu ra.
// Điểm mù cắt đuôi được VẼ RA chứ không giấu: đó là tính chất của chính cấu trúc và
// được báo cáo đúng như vậy ở Chương 4.
// Render: dot -Tpdf nonce_hmac.dot -o nonce_hmac.pdf
digraph nonce_hmac {
    rankdir=TB;
    bgcolor="white";
    nodesep=0.40;
    ranksep=0.45;
    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12,
          margin="0.20,0.12", penwidth=1.6, color="#37474f", fillcolor="#eceff1"];
    edge [fontname="Helvetica", fontsize=10, color="#546e7a", penwidth=1.3];

    subgraph cluster_in {
        label="Biên đầu vào — Đóng gói Dữ liệu Phân định";
        fontname="Helvetica"; fontsize=12; fontcolor="#2e7d32";
        style="dashed,rounded"; color="#2e7d32"; bgcolor="#f1f8e9";

        raw   [label="Trường telemetry thô\nURI · User-Agent · message · payload\n(nội dung do kẻ tấn công soạn)",
               shape=oval, fillcolor="#fdecea", color="#c62828"];
        nonce [label="Sinh nonce mới\ncho CHÍNH lô này", fillcolor="#e8f5e9", color="#2e7d32"];
        wrap  [label="[nonce] … nội dung thô … [nonce]\nchỉ thị cho mô hình: xử lý như dữ liệu thụ động",
               fillcolor="#e8f5e9", color="#2e7d32", penwidth=2.0];
    }

    reason [label="Suy luận và kiểm định phán quyết", fillcolor="#fdecea", color="#c62828"];

    subgraph cluster_out {
        label="Biên đầu ra — Chuỗi HMAC-SHA256";
        fontname="Helvetica"; fontsize=12; fontcolor="#5e35b1";
        style="dashed,rounded"; color="#5e35b1"; bgcolor="#f3e5f5";

        h1 [label="bản ghi D₁\nH₁ = HMAC(D₁ ‖ H₀, K)", fillcolor="#ede7f6", color="#5e35b1"];
        h2 [label="bản ghi D₂\nH₂ = HMAC(D₂ ‖ H₁, K)", fillcolor="#ede7f6", color="#5e35b1"];
        hn [label="bản ghi Dₙ\nHₙ = HMAC(Dₙ ‖ Hₙ₋₁, K)", fillcolor="#ede7f6", color="#5e35b1"];
        h1 -> h2 -> hn [label=" nối xích ", color="#5e35b1"];
    }

    key [label="Khoá K nạp từ biến môi trường,\nkhông bao giờ từ mã nguồn", shape=note, fillcolor="#fff8e1", color="#f9a825"];

    detect [label="PHÁT HIỆN ĐƯỢC bằng tính lại\nsửa nội dung · chèn dòng giả · xoá dòng giữa",
            fillcolor="#e8f5e9", color="#2e7d32"];
    blind  [label="KHÔNG PHÁT HIỆN ĐƯỢC\ncắt đuôi chuỗi không để lại mắt xích\nnào phía sau để đối chiếu",
            fillcolor="#fdecea", color="#c62828", penwidth=2.0];

    raw -> nonce -> wrap -> reason -> h1;
    key -> h1 [style=dashed, arrowhead=open];
    hn -> detect;
    hn -> blind [style=dashed, color="#c62828"];
}
