// SENTINEL — Đồ thị trạng thái tác tử Tầng 2 (Mục 3.4).
// Tối ưu dòng ngắn + Phông chữ siêu to 18pt (Huge Font Size).
// Render: dot -Tpdf agentic_fsm_workflow.dot -o agentic_fsm_workflow.pdf
digraph agentic_fsm {
    rankdir=TB;
    bgcolor="white";
    pad="0.05";
    nodesep=0.35;
    ranksep=0.32;
    node [shape=box, style="rounded,filled", fontname="DejaVu Serif", fontsize=18,
          margin="0.25,0.16", penwidth=2.2, color="#2e7d32", fillcolor="#e8f5e9"];
    edge [fontname="DejaVu Serif", fontsize=14, color="#37474f", penwidth=2.0];

    start   [label="Sự kiện Tầng 1 (ESCALATE)", shape=oval, fillcolor="#e3f2fd", color="#1565c0", fontsize=18, penwidth=2.2];

    guard   [label="1. Kiểm định guardrails\nLọc đầu vào · Đóng gói Nonce"];
    rag     [label="2. Truy xuất rag_context\nDual-RAG (FAISS + BM25)"];
    triage  [label="3. Phân loại llm_triage\nFoundation-Sec-8B → Pydantic JSON"];

    route1  [label="Cổng route_after_triage\nThuộc MAPPABLE ?", fillcolor="#fff8e1", color="#f9a825", penwidth=2.5];

    mapper  [label="4. Ánh xạ attack_mapper\nLàm giàu ATT&CK + Neo bằng chứng"];

    route2  [label="Cổng route_triage_decision\nPhân nhánh phán quyết", fillcolor="#fff8e1", color="#f9a825", penwidth=2.5];

    exec    [label="5. action_executor\nBLOCK_IP / ALERT\nNiêm phong HMAC", fillcolor="#fdecea", color="#c62828", penwidth=2.5];
    hitl    [label="human_in_the_loop\nDuyệt chuyên viên\n(AWAIT_HITL)", fillcolor="#fff3e0", color="#ef6c00", penwidth=2.5];

    done    [label="KẾT THÚC CHU KỲ\nCập nhật SQLite Threat Memory", shape=oval, fillcolor="#eceff1", color="#455a64", penwidth=2.2, fontsize=18];

    start -> guard -> rag -> triage -> route1;
    route1 -> mapper [label="  Có (MAPPABLE)  ", color="#2e7d32", penwidth=2.0];
    route1 -> done   [label="  Không (LOG / lành)  ", style=dashed, color="#757575"];

    mapper -> route2 [color="#2e7d32", penwidth=2.0];
    route2 -> exec [label="  BLOCK_IP / ALERT  ", color="#c62828", penwidth=2.0];
    route2 -> hitl [label="  AWAIT_HITL  ", color="#ef6c00", penwidth=2.0];
    route2 -> done [label="  LOG  ", style=dashed, color="#757575"];

    exec -> done [color="#c62828"];
    hitl -> done [color="#ef6c00"];

    { rank=same; exec; hitl; }
}
