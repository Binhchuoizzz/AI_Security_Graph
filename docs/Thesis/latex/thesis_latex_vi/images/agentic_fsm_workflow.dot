// Đồ thị trạng thái tác tử Tầng 2 của SENTINEL (nguồn của hình agentic_fsm_workflow).
// Phản ánh đúng src/agent/workflow.py: 6 nút, đồ thị có hướng không chu trình.
// Render: dot -Tpdf agentic_fsm_workflow.dot -o agentic_fsm_workflow.pdf
digraph agentic_fsm {
    rankdir=TB;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fontname="DejaVu Serif", fontsize=12, margin="0.18,0.10"];
    edge [fontname="DejaVu Serif", fontsize=10, color="#444444"];

    start   [label="BẮT ĐẦU\n(sự kiện leo thang từ Tầng 1)", shape=oval, fillcolor="#cfe8ff"];

    guard   [label="guardrails\n(kiểm định đầu vào + phòng tiêm nhiễm,\nĐóng gói Phân định)", fillcolor="#e8f5e9"];
    rag     [label="rag_context\n(Dual-RAG: MITRE ATT&CK + NIST 800-61r2,\nFAISS + BM25 hợp nhất bằng RRF)", fillcolor="#e8f5e9"];
    triage  [label="llm_triage\n(Foundation-Sec-8B Q4_K_M, temp 0,1\n→ phán quyết JSON có cấu trúc)", fillcolor="#e8f5e9"];

    route1  [label="route_after_triage\n(là đe doạ & tự tin > 0,7 ?)", shape=diamond, fillcolor="#fff3cd"];
    mapper  [label="attack_mapper\n(làm giàu MITRE ATT&CK có cấu trúc\n+ rào chắn neo bằng chứng)", fillcolor="#e8f5e9"];
    route2  [label="định tuyến theo hành động", shape=diamond, fillcolor="#fff3cd"];

    exec    [label="action_executor\n(luật tường lửa / báo cáo /\nbản ghi pháp y)", fillcolor="#f8d7da"];
    hitl    [label="human_in_the_loop\n(hàng đợi chuyên viên duyệt)", fillcolor="#ffe0b2"];

    done    [label="KẾT THÚC", shape=oval, fillcolor="#e2e3e5"];

    start -> guard -> rag -> triage -> route1;

    route1 -> mapper [label="map"];
    route1 -> exec   [label="execute_action"];
    route1 -> hitl   [label="await_hitl"];
    route1 -> done   [label="end_cycle (LOG / lành)"];

    mapper -> route2;
    route2 -> exec [label="execute_action"];
    route2 -> hitl [label="await_hitl"];
    route2 -> done [label="end_cycle"];

    exec -> done;
    hitl -> done;
}
