// SENTINEL - Sơ đồ Luồng Vận hành Hai Tầng (Hình 1 - Font Chữ To)
// Render: dot -Tpng -Gdpi=300 sentinel_flow.dot -o sentinel_flow.png

digraph sentinel_flow {
    rankdir=TB;
    bgcolor="white";
    nodesep=0.55;
    ranksep=0.6;

    node [shape=box, style="rounded,filled", fontname="DejaVu Serif Bold", fontsize=15, margin="0.25,0.18", penwidth=2.0];
    edge [fontname="DejaVu Serif Bold", fontsize=13, color="#1A252C", penwidth=1.8];

    // Inputs
    start    [label="Nhật ký Mạng Thô Đầu vào\n(NGFW, IDS/IPS, EDR -> Redis Stream)", shape=oval, fillcolor="#D6EAF8", color="#1B4F72", fontsize=16];

    // Tier 1 Group
    subgraph cluster_tier1 {
        label = "TẦNG 1: BỘ LỌC TỐC ĐỘ ĐƯỜNG TRUYỀN & CỔNG HỌC MÁY";
        style = "dashed,rounded";
        color = "#1E8449";
        bgcolor = "#EAFAF1";
        fontname = "DejaVu Serif Bold";
        fontsize = 18;
        fontcolor = "#145A32";

        t1_filter [label="Bộ lọc Thống kê Welford O(1)\n(Tính Z-Score Anomaly Trực tuyến)", fillcolor="#A9DFBF", color="#1E8449"];
        t1_cache  [label="Semantic Cache Tầng 1.75\n(Băm Payload Template RAM -> 1ms)", fillcolor="#A9DFBF", color="#1E8449"];
        t1_mlgate [label="Cổng Học máy LightGBM\n(Suy luận < 0.35ms, Anti-Evasion ±8σ)", fillcolor="#A9DFBF", color="#1E8449"];
    }

    t1_check  [label="Xác định Dị thường\nhoặc Cần Phân tích?", shape=diamond, fillcolor="#FCF3CF", color="#B7950B", fontsize=15];
    t1_benign [label="Giảm tải Tầng 1 (> 80%)\n(Quyết định: LOG / Pass)", fillcolor="#D5D8DC", color="#4A235A", fontsize=15];

    // Escalation
    escalate  [label="CHUYỂN SỰ KIỆN DỊ THƯỜNG LÊN TẦNG 2", fillcolor="#AED6F1", color="#1B4F72", fontsize=16];

    // Tier 2 Group
    subgraph cluster_tier2 {
        label = "TẦNG 2: CỖ MÁY TÁC TỬ SUY LUẬN NHẬN THỨC (LANGGRAPH AGENT)";
        style = "dashed,rounded";
        color = "#B03A2E";
        bgcolor = "#FDEDEC";
        fontname = "DejaVu Serif Bold";
        fontsize = 18;
        fontcolor = "#641E16";

        t2_guard [label="Guardrails & Security Encapsulation\n(Delimited Cryptographic Nonce + Token Miner)", fillcolor="#FADBD8", color="#B03A2E"];
        t2_rag   [label="Dual-RAG (FAISS + BM25 RRF, k=60)\n+ Threat Memory (SQLite Reputation)", fillcolor="#FADBD8", color="#B03A2E"];
        t2_llm   [label="Cỗ máy Foundation-Sec-8B-Instruct\n(Lượng tử hóa GGUF Q4_K_M via llama.cpp CUDA)", fillcolor="#FADBD8", color="#B03A2E"];
        t2_valid [label="DecisionValidator & Guardrail Tất định\n(Ép Schema Pydantic LLMDecision & Whitelist)", fillcolor="#FADBD8", color="#B03A2E"];
    }

    t2_action [label="Phán quyết\nHành động?", shape=diamond, fillcolor="#FCF3CF", color="#B7950B", fontsize=15];

    // Actions
    act_block [label="BLOCK_IP\n(Tự động chặn IP nguy hiểm)", fillcolor="#F9EBEA", color="#922B21", fontsize=16];
    act_hitl  [label="AWAIT_HITL\n(Hàng đợi Duyệt Streamlit)", fillcolor="#FDEBD0", color="#B9770E", fontsize=16];
    act_log   [label="LOG\n(Ghi nhật ký giám sát)", fillcolor="#E5E7E9", color="#5D6D7E", fontsize=16];

    // Audit
    hmac_audit [label="Niêm phong Mật mã HMAC-SHA256\n(Chuỗi Audit Log Chống Chối bỏ)", fillcolor="#E8DAEF", color="#6C3483", fontsize=16];
    end_node   [label="Kết thúc Xử lý", shape=oval, fillcolor="#E5E7E9", color="#283747", fontsize=15];

    // Connections
    start -> t1_filter;
    t1_filter -> t1_cache -> t1_mlgate -> t1_check;
    t1_check -> t1_benign [label=" Không (Bình thường) "];
    t1_check -> escalate  [label=" Có (Dị thường) "];

    escalate -> t2_guard;
    t2_guard -> t2_rag -> t2_llm -> t2_valid -> t2_action;

    t2_action -> act_block [label=" BLOCK_IP "];
    t2_action -> act_hitl  [label=" AWAIT_HITL "];
    t2_action -> act_log   [label=" LOG "];

    act_block -> hmac_audit;
    act_hitl  -> hmac_audit;
    act_log   -> hmac_audit;
    t1_benign -> hmac_audit;

    hmac_audit -> end_node;
}
