# ================================================================
# SENTINEL — Environment Configuration
# ================================================================

# REDIS CONFIGURATION
# Secret CHỈ sống trong .env (gitignored) — file example này chỉ giữ placeholder.
# Đặt mật khẩu mạnh của bạn rồi giữ 2 biến nhất quán với nhau.
REDIS_PASSWORD=change-me-strong-password
REDIS_URL=redis://:change-me-strong-password@localhost:6379/0

# MLFLOW TRACKING URL
MLFLOW_TRACKING_URI=http://localhost:5001

# LLM CONFIGURATION (llama.cpp server — auto-started by docker-compose)
# Khi chạy trong Docker: http://llm:8080/v1 (auto-set bởi docker-compose)
# Khi chạy ngoài Docker (venv): http://127.0.0.1:5000/v1
LLM_API_BASE=http://127.0.0.1:5000/v1
LLM_API_KEY=sk-placeholder-local-only
MOCK_LLM=0  # Set to 1 to mock LLM responses when server is down

# LLM MODEL PATH (for docker-compose volume mount)
# Đường dẫn tuyệt đối tới thư mục chứa file .gguf trên máy Host
LLM_MODEL_DIR=/home/binhchuoiz/text-generation-webui/user_data/models
LLM_MODEL_FILE=Foundation-Sec-8B-Instruct-Q4_K_M.gguf

# NEO4J CONFIGURATION (Optional — V2 Architecture)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j-password

# UI AUTHENTICATION (PBKDF2-HMAC-SHA256, 100k vòng — KHÔNG phải bcrypt)
# Production BẮT BUỘC đặt cả 3 biến dưới (nếu trống -> rơi về HASH/SALT demo + cảnh báo).
# Sinh hash:  python -c "import hashlib,os; print(hashlib.pbkdf2_hmac('sha256', b'<mật_khẩu>', os.environ['SENTINEL_AUTH_SALT'].encode(), 100000).hex())"
SENTINEL_AUTH_SALT=please_change_this_to_a_unique_random_salt
SENTINEL_ANALYST_HASH=  # 64 ký tự hex PBKDF2 cho tài khoản analyst
SENTINEL_MANAGER_HASH=  # 64 ký tự hex PBKDF2 cho tài khoản manager

# AUDIT TRAIL HMAC KEY (chuỗi băm chống giả mạo của config/audit_trail.db)
# Đây là khóa KÝ toàn bộ sổ kiểm toán. Nếu KHÔNG đặt, code rơi về một khóa mặc định nằm
# ngay trong mã nguồn công khai — nghĩa là BẤT KỲ AI đọc repo cũng tính lại được hash hợp
# lệ và sửa/chèn/xoá bản ghi mà verify_audit_trail_integrity() vẫn báo "toàn vẹn". Tính
# chống-giả-mạo khi ấy chỉ còn là hình thức.
# Sinh khóa:  python -c "import secrets; print(secrets.token_hex(32))"
SENTINEL_LOG_SECRET=

# ĐẨY LUỒNG (tùy chọn - đã có mặc định hợp lý)
# scripts/demo.py và scripts/push_datatest.py đọc hai biến này. Bỏ SIMULATE_BATCH_SIZE và
# SIMULATE_DELAY vì simulate_traffic.py đã bị gỡ, không tệp nào còn đọc chúng nữa.
UNIFIED_STREAM_BATCH=50
UNIFIED_STREAM_DELAY=0.3

# Tầng 2: LLM cục bộ và tracer
# Sáu biến dưới đây có trong .env thật nhưng trước nay chưa được ghi ở đây, nên người
# clone repo về sẽ chạy bằng mặc định mà không biết là có chúng.
LLAMA_ARG_CTX_SIZE=16384          # trần ngữ cảnh của llama-server
LLAMA_ARG_CACHE_REUSE=256         # số token đầu prompt được dùng lại từ KV-cache
SENTINEL_AGENT_WORKERS=2          # số luồng chạy đồ thị LangGraph song song
SENTINEL_TRACE=0                  # 1 = ghi vết từng node của Tầng 2
SENTINEL_TRACE_FILE=logs/tier2_trace.jsonl
SENTINEL_TRACE_MAX_CHARS=4000     # cắt bớt trường dài trong vết cho khỏi phình tệp
